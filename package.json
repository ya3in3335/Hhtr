{
  "name": "ultron-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper that packages the Ultron chatbot PWA into an Android APK.",
  "scripts": {
    "add:android": "cap add android",
    "sync": "cap sync android",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  }
}
